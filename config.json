{
  "LogDirectory": "C:\\inetpub\\logs\\LogFiles",
  "SearchSubdirectories": false,
  "LogFileNamePattern": "^(?<date>\\d{8})[-_](?<server>.+)\\.log$",
  "OutputDirectory": "C:\\IISReports\\output",

  "Servers": [],

  "TargetExtensions": [".aspx"],
  "IncludeMethods": [],
  "LowercaseUrl": true,
  "StripTrailingSlash": false,

  "InternalIpAddresses": ["127.0.0.1", "::1"],
  "InternalIpRanges": ["10.0.0.0/8", "192.168.0.0/16", "172.16.0.0/12"],
  "ClientIpFields": ["c-ip"],

  "BotUserAgentContains": ["bot", "crawler", "spider", "slurp", "bingpreview", "pingdom", "uptimerobot", "healthcheck"],
  "ExcludeUriPatterns": ["^/elmah\\.axd", "^/trace\\.axd"],

  "SessionTimeoutMinutes": 30,

  "LogTimeIsUtc": true,
  "TimeZoneOffsetHours": 9,

  "RequestFileNameFormat": "iis_request_{date}.csv",
  "UniqueFileNameFormat": "iis_unique_{date}.csv",
  "VisitFileNameFormat": "iis_visit_{date}.csv",
  "FlowFileNameFormat": "iis_flow_{date}.csv",
  "UserFileNameFormat": "iis_user_{date}.csv",
  "OutputEncoding": "utf8",
  "RetentionDays": 0,

  "MaxDegreeOfParallelism": 0
}
