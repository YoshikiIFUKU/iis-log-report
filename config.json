{
  "LogDirectory": "C:\\inetpub\\logs\\LogFiles",
  "SearchSubdirectories": false,
  "OutputDirectory": "C:\\IISReports\\output",

  "Servers": [],

  "TargetExtensions": [".aspx"],
  "IncludeMethods": ["GET", "POST"],
  "ExcludeStatusCodes": [],
  "LowercaseUrl": true,
  "StripTrailingSlash": false,

  "ExcludeIpAddresses": ["127.0.0.1", "::1"],
  "ExcludeIpRanges": ["10.0.0.0/8", "192.168.0.0/16", "172.16.0.0/12"],
  "ClientIpFields": ["c-ip"],

  "ExcludeUserAgentContains": ["bot", "crawler", "spider", "slurp", "bingpreview", "pingdom", "uptimerobot", "healthcheck"],
  "ExcludeUriPatterns": ["^/elmah\\.axd", "^/trace\\.axd"],

  "LogTimeIsUtc": true,
  "TimeZoneOffsetHours": 9,

  "PageFileNameFormat": "iis_page_{date}.csv",
  "DailyFileNameFormat": "iis_daily_{date}.csv",
  "WriteDailySummary": true,
  "OutputEncoding": "utf8",
  "RetentionDays": 0,

  "MaxDegreeOfParallelism": 0
}
